+	// Jolt's outward rounding from double world positions to float broadphase bounds.
+	AABox bounds = mShape->GetWorldSpaceBounds(RMat44::sRotationTranslation(inRotation, inPosition), Vec3::sOne());
+	Vec3 limit = Vec3::sReplicate(cLargeFloat);
+	return bounds.IsValid()
