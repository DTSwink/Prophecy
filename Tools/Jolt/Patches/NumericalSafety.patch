+bool Body::CanUseTransformInternal(RVec3Arg inPosition, QuatArg inRotation) const
+{
+	// QuadTree bounds are restricted to +/-cLargeFloat, substantially below float
+	// overflow. Check this before a correction reaches CalculateWorldSpaceBounds.
+	if (!std::isfinite(inPosition.GetX()) || !std::isfinite(inPosition.GetY()) || !std::isfinite(inPosition.GetZ()))
+		return false;
+	double max_position = max(max(std::abs(double(inPosition.GetX())), std::abs(double(inPosition.GetY()))), std::abs(double(inPosition.GetZ())));
+	if (!std::isfinite(max_position) || max_position > double(cLargeFloat))
+		return false;
+
+	// Local bounds are relative to the COM and may be asymmetric. Their maximum
+	// absolute corner includes that offset. Twice its L1 norm conservatively covers
+	// every unit-quaternion rotation, including float matrix rounding. This keeps
+	// ordinary corrections off the more expensive exact world-bounds path.
+	AABox local = mShape->GetLocalBounds();
+	if (!sIsValidRotationStep(local.mMin) || !sIsValidRotationStep(local.mMax))
+		return false;
+	Vec3 corner = Vec3::sMax(local.mMin.Abs(), local.mMax.Abs());
+	double radius = 2.0 * (double(corner.GetX()) + double(corner.GetY()) + double(corner.GetZ()));
+	if (!local.IsValid() || !std::isfinite(radius))
+		return false;
+	if (max_position + radius < double(cLargeFloat))
+		return true;
