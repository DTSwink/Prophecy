// Explicit inspector only. Fixtures are generated by the unchanged lab solver.
#include "Serialization/JsonReader.h"
#include "Serialization/JsonSerializer.h"
static void VerifyReachLabPort()
{
    const FString Dir=FPaths::ProjectSavedDir()/TEXT("Diagnostics/ReachPort20261016/");
    FString Raw;TArray<TSharedPtr<FJsonValue>> Rows;
    if(!FFileHelper::LoadFileToString(Raw,*(Dir+TEXT("lab-parity.json")))||!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Raw),Rows))return;
    auto V=[](const TArray<TSharedPtr<FJsonValue>>& A){return FVector(A[0]->AsNumber(),A[1]->AsNumber(),A[2]->AsNumber());};
    auto Q=[](const TArray<TSharedPtr<FJsonValue>>& A,int I=0){return FQuat(A[I]->AsNumber(),A[I+1]->AsNumber(),A[I+2]->AsNumber(),A[I+3]->AsNumber());};
    double Position=0,Rotation=0,PlanError=0,PlanRotation=0,PlanDirection=0,PostureError=0,PoleError=0,FitSeconds=0;int Cases=0,EvaluationMismatches=0,FeasibilityMismatches=0;
    for(const auto& Row:Rows)
    {
        const auto R=Row->AsObject(),In=R->GetObjectField(TEXT("input")),Expected=R->GetObjectField(TEXT("expected")),Joint=In->GetObjectField(TEXT("joint"));
        FConstraintInstance J;J.SetRefFrame(EConstraintFrame::Frame1,FTransform(Q(Joint->GetArrayField(TEXT("frame1")))));J.SetRefFrame(EConstraintFrame::Frame2,FTransform(Q(Joint->GetArrayField(TEXT("frame2")))));
        const auto& Modes=Joint->GetArrayField(TEXT("modes"));const auto& Limits=Joint->GetArrayField(TEXT("limits"));auto& P=J.ProfileInstance;
        P.TwistLimit.TwistMotion=static_cast<EAngularConstraintMotion>(int(Modes[0]->AsNumber()));P.ConeLimit.Swing2Motion=static_cast<EAngularConstraintMotion>(int(Modes[1]->AsNumber()));P.ConeLimit.Swing1Motion=static_cast<EAngularConstraintMotion>(int(Modes[2]->AsNumber()));
        P.TwistLimit.TwistLimitDegrees=Limits[0]->AsNumber();P.ConeLimit.Swing2LimitDegrees=Limits[1]->AsNumber();P.ConeLimit.Swing1LimitDegrees=Limits[2]->AsNumber();
        const bool First=Joint->GetBoolField(TEXT("handFirst"));
        auto Project=[&](FQuat Forearm,FQuat Hand,bool Reverse){return ProphecyReachWristLimits::Constrain(J,Reverse?!First:First,Forearm,Hand);};
        ProphecyReachArm::FInput I;I.Shoulder=V(In->GetArrayField(TEXT("shoulder")));I.RawElbow=V(In->GetArrayField(TEXT("rawElbow")));I.BaseHand=V(In->GetArrayField(TEXT("baseHand")));I.Anchor=V(In->GetArrayField(TEXT("anchor")));I.Palm=V(In->GetArrayField(TEXT("palm")));
        I.Desired=Q(In->GetArrayField(TEXT("desired")));I.Command=Q(In->GetArrayField(TEXT("command")));I.UpperLength=In->GetNumberField(TEXT("upperLength"));I.LowerLength=In->GetNumberField(TEXT("lowerLength"));I.Speed=In->GetNumberField(TEXT("speed"));
        I.HasForearmHint=In->HasField(TEXT("forearmHint"));if(I.HasForearmHint)I.ForearmHint=Q(In->GetArrayField(TEXT("forearmHint")));
        if(In->HasField(TEXT("poleHint")))I.PoleHint=V(In->GetArrayField(TEXT("poleHint")));
        const auto& Prev=In->GetArrayField(TEXT("previous"));for(int N=0;N<3;++N){const auto& A=Prev[N]->AsArray();I.Previous[N]=FTransform(Q(A,3),V(A));}
        const auto Actual=ProphecyReachArm::Solve(I,Project);
        const FTransform Out[]={Actual.Upper,Actual.Lower,Actual.Hand};const TCHAR* Keys[]={TEXT("upper"),TEXT("lower"),TEXT("hand")};
        for(int N=0;N<3;++N){const auto& A=Expected->GetArrayField(Keys[N]);Position=FMath::Max(Position,FVector::Distance(Out[N].GetLocation(),V(A)));Rotation=FMath::Max(Rotation,1-FMath::Abs(Out[N].GetRotation()|Q(A,3)));}
        EvaluationMismatches+=Actual.Evaluations!=int(Expected->GetNumberField(TEXT("evaluations")));
        const auto PlanInput=R->GetObjectField(TEXT("planInput")),PostureExpected=R->GetObjectField(TEXT("planExpected")),PE=PostureExpected->GetObjectField(TEXT("extent"));
        const bool Locked=P.TwistLimit.TwistMotion==ACM_Locked&&P.ConeLimit.Swing1Motion==ACM_Locked&&P.ConeLimit.Swing2Motion==ACM_Locked;
        double UpperLength=0;PlanInput->TryGetNumberField(TEXT("upperLength"),UpperLength);
        auto Plan=ProphecyReachArm::PlanStraight(V(PlanInput->GetArrayField(TEXT("shoulder"))),V(PlanInput->GetArrayField(TEXT("wrist"))),Q(PlanInput->GetArrayField(TEXT("desired"))),V(PlanInput->GetArrayField(TEXT("localLower"))),Locked,Project);
        double PriorRoll=0;
        if(PlanInput->HasField(TEXT("prior")))
        {
            const auto Prior=PlanInput->GetObjectField(TEXT("prior"));
            PriorRoll=Prior->GetNumberField(TEXT("roll"));const auto Extent=Prior->GetObjectField(TEXT("extent"));
            if(PlanInput->GetBoolField(TEXT("sameTarget")))Plan={Q(Extent->GetArrayField(TEXT("forearm"))),Extent->GetNumberField(TEXT("cos")),int(Extent->GetNumberField(TEXT("evaluations")))};
            else Plan=ProphecyReachArm::Track(V(PlanInput->GetArrayField(TEXT("shoulder"))),V(PlanInput->GetArrayField(TEXT("wrist"))),Q(PlanInput->GetArrayField(TEXT("desired"))),V(PlanInput->GetArrayField(TEXT("localLower"))),V(Prior->GetArrayField(TEXT("wrist"))),Q(Prior->GetArrayField(TEXT("rotation"))),Q(Extent->GetArrayField(TEXT("forearm"))),Project);
        }
        EvaluationMismatches+=Plan.Evaluations!=int(PE->GetNumberField(TEXT("evaluations")));
        PlanError=FMath::Max(PlanError,FMath::Abs(Plan.Cos-PE->GetNumberField(TEXT("cos"))));
        const FQuat ExpectedForearm=Q(PE->GetArrayField(TEXT("forearm")));
        PlanRotation=FMath::Max(PlanRotation,1-FMath::Abs(Plan.Forearm|ExpectedForearm));
        const FVector LocalLower=V(PlanInput->GetArrayField(TEXT("localLower")));
        PlanDirection=FMath::Max(PlanDirection,FVector::Distance(Plan.Forearm.RotateVector(LocalLower),ExpectedForearm.RotateVector(LocalLower)));
        const auto Posture=ProphecyReachArm::Posture(V(PlanInput->GetArrayField(TEXT("shoulder"))),V(PlanInput->GetArrayField(TEXT("wrist"))),LocalLower,UpperLength,PlanInput->GetNumberField(TEXT("sign")),PlanInput->GetNumberField(TEXT("blend")));
        const double Begin=FPlatformTime::Seconds();
        const auto Fit=ProphecyReachWristTwist::Fit(J,First,Q(PlanInput->GetArrayField(TEXT("desired"))),LocalLower,Posture.Direction,PriorRoll);FitSeconds+=FPlatformTime::Seconds()-Begin;
        PostureError=FMath::Max(PostureError,1-FMath::Abs(Fit.Forearm|Q(PostureExpected->GetArrayField(TEXT("forearm")))));
        PoleError=FMath::Max(PoleError,FVector::Distance(Posture.Pole,V(PostureExpected->GetArrayField(TEXT("pole")))));
        FeasibilityMismatches+=Fit.Feasible!=PostureExpected->GetBoolField(TEXT("feasible"));++Cases;
    }
    const bool Passed=Cases==Rows.Num()&&Cases>0&&Position<1.e-4&&Rotation<1.e-7&&PlanError<1.e-6&&PlanDirection<1.e-4&&EvaluationMismatches==0&&PostureError<1.e-7&&PoleError<1.e-7&&FeasibilityMismatches==0;
    FFileHelper::SaveStringToFile(FString::Printf(TEXT("{\"passed\":%s,\"cases\":%d,\"positionCm\":%.12g,\"quaternionError\":%.12g,\"planCosError\":%.12g,\"planQuaternionError\":%.12g,\"planDirectionCm\":%.12g,\"evaluationMismatches\":%d,\"postureQuaternionError\":%.12g,\"poleError\":%.12g,\"feasibilityMismatches\":%d,\"twistMeanMs\":%.12g}"),Passed?TEXT("true"):TEXT("false"),Cases,Position,Rotation,PlanError,PlanRotation,PlanDirection,EvaluationMismatches,PostureError,PoleError,FeasibilityMismatches,1000*FitSeconds/FMath::Max(1,Cases)),*(Dir+TEXT("native-parity.json")));
}
